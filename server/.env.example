# Required: Telegram bot and administrator
TG_BOT_TOKEN=
# Channel for admin news publishing (e.g. @delis_news). The bot must be an
# admin of the channel to post. Leave empty to disable the feature.
TELEGRAM_NEWS_CHANNEL=
# Optional dedicated HMAC secret for browser checkout sessions.
# Generate at least 32 random bytes; when empty, TG_BOT_TOKEN is used.
BROWSER_SESSION_SECRET=
# Reject replayed Telegram initData older than this (default: 24 hours).
TG_INIT_DATA_MAX_AGE_SECONDS=86400
ADMIN_CHAT_ID=
APP_URL=https://app.delis.uz
BOT_USERNAME=delisgroup_bot
PORT=3001
TZ=Asia/Tashkent
SEED_ON_START=true
# Demo promos are inserted disabled unless explicitly enabled and reviewed.
ENABLE_SEEDED_PROMOS=false

# Reports, couriers and support
REPORT_HOUR=18
BACKUP_HOUR=3
COURIER_CHAT_IDS=
SUPPORT_PHONE=+998 88 044-66-55
SUPPORT_PHONE_2=+998 94 331-64-64
SUPPORT_MANAGER_TG=@Sk1py

# Payme runtime configuration
PAYME_MERCHANT_ID=
PAYME_KEY=

# Click runtime configuration
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET=

# Supabase Storage (recommended on Render/free ephemeral filesystems)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# DEV/PREVIEW ONLY. Pair with frontend VITE_DEV_ADMIN_TOKEN.
# Never set this in production.
DELIS_DEV_ADMIN_TOKEN=
