{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delis-tg-admin",
  "main": "worker.js",
  "compatibility_date": "2026-08-10",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
