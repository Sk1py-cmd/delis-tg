# ── Required backend settings ────────────────────────────────
# Telegram bot token from @BotFather
TG_BOT_TOKEN=
# Channel for admin news publishing (e.g. @delis_news). The bot must be an
# admin of the channel to post. Leave empty to disable the feature.
TELEGRAM_NEWS_CHANNEL=
# Optional dedicated HMAC secret for 30-day browser checkout sessions.
# Generate at least 32 random bytes; when empty, TG_BOT_TOKEN is used.
BROWSER_SESSION_SECRET=
# Reject replayed Telegram initData older than this (default: 24 hours).
TG_INIT_DATA_MAX_AGE_SECONDS=86400
# Telegram ID of the administrator/manager
ADMIN_CHAT_ID=
# Public Mini App URL, exact origin without a trailing slash
APP_URL=https://app.delis.uz
BOT_USERNAME=delisgroup_bot
PORT=3001
TZ=Asia/Tashkent
SEED_ON_START=true
# Demo promos are inserted disabled unless explicitly enabled and reviewed.
ENABLE_SEEDED_PROMOS=false

# ── Reports, couriers and support ─────────────────────────────
REPORT_HOUR=18
BACKUP_HOUR=3
# Comma-separated Telegram IDs; empty means ADMIN_CHAT_ID only
COURIER_CHAT_IDS=
SUPPORT_PHONE=+998 88 044-66-55
SUPPORT_PHONE_2=+998 94 331-64-64
SUPPORT_MANAGER_TG=@Sk1py

# ── Payments ─────────────────────────────────────────────────
# Both providers can ALSO be filled in from the bot admin panel
# (tab «Платежи») — those values win and apply without a redeploy.
# Anything left empty here simply falls back to the admin panel.

# Payme (all values come from the merchant cabinet)
PAYME_MERCHANT_ID=
PAYME_KEY=

# Click (all values come from the merchant cabinet)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET=

# Public origin of THIS API — only needed when the API sits behind a proxy
# that rewrites the Host header. Used to print webhook URLs in the admin panel.
PUBLIC_API_URL=

# ── Supabase Storage (recommended on ephemeral hosting) ──────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Frontend build/dev ────────────────────────────────────────
# "/" = same-origin API (Vite proxy locally; Fastify in Docker/Render).
# Use a full URL only when frontend and API are hosted separately.
VITE_API_URL=/
# Set only for a subpath static host such as GitHub Pages.
VITE_BASE_PATH=/
# Local preview only: must match server DELIS_DEV_ADMIN_TOKEN.
# Never set either token in production.
VITE_DEV_ADMIN_TOKEN=
DELIS_DEV_ADMIN_TOKEN=
